+// material balance from the mover's point of view; board = 32 dark squares x { own man, own king, opp man, opp king }
+static double material_balance(std::vector<double> const& b)
+{
+	double own{}, opp{};
+	for (size_t i = 0; i + 3 < b.size(); i += 4)
+	{
+		own += b[i] + 2. * b[i + 1];
+		opp += b[i + 2] + 2. * b[i + 3];
+	}
+	return own - opp;
+}
